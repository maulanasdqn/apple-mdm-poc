# HTTP server bind address
SERVER_ADDR=0.0.0.0:8080

# Public base URL the device reaches (ServerURL / CheckInURL are derived from this).
# Locally, point this at an ngrok / cloudflared tunnel terminating TLS.
BASE_URL=https://mdm.example.com

# SQLite database (file is created on first run; use sqlite::memory: for ephemeral)
DATABASE_URL=sqlite://mdm.db?mode=rwc

# APNs push topic — must equal the subject UID of the vendor MDM push certificate.
# Dev placeholder; replace with the real topic once you have the vendor cert.
MDM_TOPIC=com.apple.mgmt.External.00000000-0000-0000-0000-000000000000

# APNs mode: "noop" (logs instead of pushing) or "real" (uses APNS_CERT_PATH).
APNS_MODE=noop
# APNS_CERT_PATH=certs/push.p12
# APNS_CERT_PASSWORD=

# Certificate material (generated by the dev cert helper; gitignored).
CA_CERT_PATH=certs/ca.pem
CA_KEY_PATH=certs/ca.key
SIGNING_CERT_PATH=certs/signing.pem
SIGNING_KEY_PATH=certs/signing.key

# Log filter
RUST_LOG=info,mdm=debug,gateway=debug
